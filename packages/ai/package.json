{
  "name": "@workspace/ai",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./providers/*": "./src/providers/*.ts",
    "./prompts/*": "./src/prompts/*.ts",
    "./operations/*": "./src/operations/*.ts",
    "./schemas": "./src/schemas.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@workspace/logger": "workspace:*",
    "openai": "7.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "~6"
  }
}
