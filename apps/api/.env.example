# Database
DATABASE_URL=postgres://template:template@localhost:5432/template

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Server
CLIENT_URL=http://localhost:5173
PORT=3001
LOG_LEVEL=info

# Email (console | mailpit | resend)
EMAIL_PROVIDER=mailpit
# MAILPIT_HOST=localhost
# MAILPIT_SMTP_PORT=1025
EMAIL_FROM=noreply@localhost
# RESEND_API_KEY=

# S3 Storage (AWS S3 / GCS / R2 / local S3-compatible endpoint)
# Leave S3_ENDPOINT empty for standard AWS S3
# S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_BUCKET=template
# S3_BASE_URL=
